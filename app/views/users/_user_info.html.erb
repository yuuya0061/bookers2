<h2>User info</h2>

<%= render "users/profile_image", user: user %>

<table class="table">
  <tbody>
    <tr>
      <th>name</th>
      <td><%= user.name %></td>
    </tr>
    <tr>
      <th>introduction</th>
      <td><%= simple_format(user.introduction) %></td>
    </tr>
  </tbody>
</table>

<%= link_to edit_user_path(user), class: "btn btn-outline-secondary w-100" do %> 
  <i class="fas fa-user-cog"></i>
<% end %>