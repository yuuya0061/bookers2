

<div class="row">
  <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
    <h2>Sign up</h2>
    <%= form_with model: @user, url: users_path do |f| %>
      <% if @user.errors.any? %>
        <div id="error_explanation">
          <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, class: "mb-1" %>
        <%= f.text_field :name, class: "form-control", autofocus: true %>
      </div>

      <div class="mb-3">
        <%= f.label :email_address, class: "mb-1" %>
        <%= f.email_field :email_address, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "mb-1" %>
        <%= f.password_field :password, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, class: "mb-1" %>
        <%= f.password_field :password_confirmation, class: "form-control" %>
      </div>

      <div class="mb-2">
        <%= f.submit "Sign up", class: "btn btn-success" %>
      </div>
    <% end %>

    <%= link_to "Log in", new_session_path %><br>
  </div>
</div>