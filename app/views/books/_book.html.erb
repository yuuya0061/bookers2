<h2>Book detail</h2>

<table class="table">
  <tbody>
    <tr>
      <td>
        <%= render "users/profile_image", user: book.user %><br>
        <%= link_to book.user.name, book.user %>
      </td>
      <td><%= book.title %></td>
      <td><%= simple_format book.body %></td>
      <% if book.user == Current.user %>
        <td><%= link_to "Edit", edit_book_path(book), class: "btn btn-success" %></td>
        <td>
          <%= link_to "Destroy", book, class: "btn btn-danger",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "本当に消しますか?"
                } %>
        </td>
      <% end %>
    </tr>
  </tbody>
</table>