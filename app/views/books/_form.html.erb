<%= form_with(model: book) do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :body, "Opinion" %>
    <%= f.text_area :body, rows: 3, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.submit class: "btn btn-success" %>
  </div>
<% end %>