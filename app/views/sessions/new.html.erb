<div class="row">
  <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
    <h2>Log in</h2>
    <%= form_with url: session_path do |form| %>
      <div class="mb-3">
        <%= form.label :name, class: "mb-1" %>
        <%= form.text_field :name, class: "form-control", required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your name", value: params[:name] %>
      </div>
      <div class="mb-3">
        <%= form.label :password, class: "mb-1" %>
        <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %>
      </div>
      <div class="mb-2">
        <%= form.submit "Log in", class: "btn btn-primary" %>
      </div>
    <% end %>
          
    <%= link_to "Sign up", new_user_path %><br>

    <%= link_to "Forgot your password?", new_password_path %>
  </div>
</div>